{
  "name": "dsh-life-wiki",
  "version": "0.2.1",
  "description": "Life Wiki（人生知识库）— 本地优先的 Markdown 个人项目、日记、复盘与知识库 DSH 插件",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "dsh": ">=0.2.0-0 <0.3.0-0"
  },
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "life-wiki",
    "markdown",
    "local-first",
    "pkm"
  ],
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots"
      ]
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build.mjs",
    "test": "node --test test/vault.test.ts test/http.test.ts",
    "test:all": "npm run typecheck && npm run build && npm test && node --test test/build.test.mjs",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "esbuild": "^0.25.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "typescript": "^5.8.0"
  }
}
